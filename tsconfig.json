{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "node16",
    "moduleResolution": "node16",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    /* Linting */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* Paths */
    "paths": {
      "~api/*": ["./src/app/api/*"],
      "~constants/*": ["./src/constants/*"],
      "~hooks/*": ["./src/hooks/*"],
      "~lib/*": ["./src/lib/*"],
      "~modules/*": ["./src/modules/*"],
      "~services/*": ["./src/services/*"],
      "~styles/*": ["./src/styles/*"],
      "~ui/*": ["./src/components/ui/*"],
      "~utils/*": ["./src/utils/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    "src/lib/articles/optimizing-your-react-application-for-the-interaction-to-next-paint-inp-web-vitals-metric.mdx"
  ],
  "exclude": ["node_modules", ".next"]
}
