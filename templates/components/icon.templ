package components

import "strconv"

type IconName string

const (
	IconGithub   IconName = "github"
	IconLinkedin IconName = "linkedin"
	IconReddit   IconName = "reddit"
	IconVolume   IconName = "volume"
	IconYoutube  IconName = "youtube"
	IconMail     IconName = "mail"
)

type IconOptions struct {
	Name        IconName
	Size        int
	StrokeWidth float64
	Class       string
}

func iconSize(size int) string {
	if size <= 0 {
		return "16"
	}
	return strconv.Itoa(size)
}

func iconStrokeWidth(sw float64) string {
	if sw <= 0 {
		return "2"
	}
	return strconv.FormatFloat(sw, 'f', -1, 64)
}

templ Icon(o IconOptions) {
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width={ iconSize(o.Size) }
		height={ iconSize(o.Size) }
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width={ iconStrokeWidth(o.StrokeWidth) }
		stroke-linecap="round"
		stroke-linejoin="round"
		class={ "aspect-square shrink-0", o.Class }
		aria-hidden="true"
	>
		switch o.Name {
			case IconGithub:
				<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
				<path d="M9 18c-4.51 2-5-2-7-2"></path>
			case IconLinkedin:
				<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
				<rect width="4" height="12" x="2" y="9"></rect>
				<circle cx="4" cy="4" r="2"></circle>
			case IconReddit:
				<path d="M8 17.5c4.17 3 8 0 8 0m-4.5-9h.67c5 0 6.33 1.5 6.33 1.5 2.5-1.5 5.5 2 3 4 0 2.5-1.83 7-9.33 7S3 17 3 14.5c-3.5-2.5-.5-6 2.5-4.5 0 0 1.52-1.37 6-1.5Zm0 0 1.5-6 3 .5M9.5 13.5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm7.5 0a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Zm3-10a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"></path>
			case IconVolume:
				<path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"></path>
				<path d="M16 9a5 5 0 0 1 0 6"></path>
				<path d="M19.364 18.364a9 9 0 0 0 0-12.728"></path>
			case IconYoutube:
				<path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"></path>
				<path d="m10 15 5-3-5-3z"></path>
			case IconMail:
				<path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"></path><rect x="2" y="4" width="20" height="16" rx="2"></rect>
		}
	</svg>
}
